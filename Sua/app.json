{
  "expo": {
    "name": "Sua",
    "slug": "Sua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "sua",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icons/icon.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#005B45",
        "foregroundImage": "./assets/images/icons/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pdordj.Sua",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005B45",
          "image": "./assets/images/icons/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record your lectures and classes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to attach a photo of your slides or notes.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to photograph the board or your notes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons/notification-icon.png",
          "color": "#005B45",
          "defaultChannel": "study"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ae5fd5d-6679-4e41-af81-2084c5a9a6a0"
      }
    }
  }
}
