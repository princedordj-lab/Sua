{
  "expo": {
    "name": "Sua",
    "slug": "Sua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "sua",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icons/icon.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#005B45",
        "foregroundImage": "./assets/images/icons/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pdordj.Sua"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005B45",
          "image": "./assets/images/icons/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record your lectures and classes."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ae5fd5d-6679-4e41-af81-2084c5a9a6a0"
      }
    }
  }
}
