# Clerk publishable key (Expo app). Backend secret goes in backend/.env
#
# This key and the backend's CLERK_PUBLISHABLE_KEY / CLERK_SECRET_KEY must come
# from the SAME Clerk instance. A `pk_live_` app pointed at a `pk_test_` API (or
# the reverse) signs students in fine and then answers 401 to every request, so
# the app can never load their profile. The publishable key encodes the instance
# in base64 after `pk_test_` / `pk_live_`; compare it with the backend's key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Backend API. Android emulator: http://10.0.2.2:4000/api
# Prefer https:// for anything other than localhost: Android release builds
# block cleartext HTTP, and an http:// host that redirects costs a round trip.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# Clerk Account Portal for this instance (Dashboard -> Account Portal). Used by
# Profile -> Security for password/device management. Leave empty to hide the
# row: the app's own forgot-password flow does not depend on it.
EXPO_PUBLIC_CLERK_ACCOUNT_PORTAL_URL=
