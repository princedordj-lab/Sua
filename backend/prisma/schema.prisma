generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // Imports must be ".js": the files are generated as .ts, but every runtime
  // that compiles them (esbuild, Vercel's builder) emits .js, and ESM resolution
  // is literal. ".ts" specifiers only work under tsx, which is why the Vercel
  // function crashed with ERR_MODULE_NOT_FOUND on internal/class.ts.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  clerkId              String    @unique
  email                String    @unique
  name                 String?
  imageUrl             String?
  university           String?
  programme            String?
  level                String?
  plan                 String    @default("FREE")
  planExpiresAt        DateTime?
  onboardingCompletedAt DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  courses              Course[]
  notes                Note[]
  assets               Asset[]
  jobs                 Job[]
  flashcards           Flashcard[]
  quizzes              Quiz[]
  feedbacks            Feedback[]
  usages               Usage[]
  pushTokens           PushToken[]
  chatMessages         ChatMessage[]
  reviewLogs           ReviewLog[]
  quizAttempts         QuizAttempt[]
  noteTombstones       NoteTombstone[]
  sourceChunks         SourceChunk[]

  @@map("users")
}

model Course {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  examDate  DateTime?
  colour    String   @default("#7C5CFC")
  lecturer  String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
  chatMessages ChatMessage[]

  @@index([userId])
  @@map("courses")
}

model Note {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String   @default("")
  body       String   @default("")
  sourceType String   @default("typed")
  // AI pipeline outputs; the server owns them, the device mirrors.
  transcript String?
  summary    String?
  aiState    String   @default("none")
  // note = study note; reference = AI course reference sheet
  noteKind   String   @default("note")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs       Job[]
  flashcards Flashcard[]
  quizzes    Quiz[]
  assets     Asset[]

  // Split-mode provenance (long files): the asset this note was generated
  // from, the group id linking overview + parts, and this note's 1-based part
  // number (0 = overview). All nullable: short sources stay plain notes.
  sourceAssetId String?
  groupId       String?
  partIndex     Int?

  @@index([userId, updatedAt])
  @@index([courseId, updatedAt])
  @@index([groupId])
  @@map("notes")
}

// A deleted note's id, kept so a late or out-of-order upsert cannot resurrect
// it. Rows are cheap; prune anything older than 90 days when they accumulate.
model NoteTombstone {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime @default(now())

  @@index([userId, deletedAt])
  @@map("note_tombstones")
}

model Asset {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  publicId     String
  storageProvider String @default("cloudinary")
  cloudinaryCleanupPending Boolean @default(false)
  secureUrl    String?
  bytes        Int      @default(0)
  format       String?
  resourceType String   @default("raw")
  status       String   @default("pending")
  noteId       String?
  // Cascade: the file (and its extracted text) belongs to the note and must not
  // outlive it. Storage bytes are deleted separately (StorageDeletion retries).
  note         Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  // none = plain upload; lecture_note / course_reference = auto AI conversion
  task         String   @default("none")
  extractedText String?
  // Resumable page-wise extraction (long-file pipeline).
  // none = legacy asset / not a document; pending = /complete verified the
  // object and queued extraction; running | done | partial | failed follow.
  extractState   String   @default("none")
  pagesDone      Int      @default(0)
  pagesTotal     Int      @default(0)
  nextPage       Int      @default(1)
  truncated      Boolean  @default(false)
  ocrPages       Int      @default(0)
  extractErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks     SourceChunk[]

  @@index([userId])
  @@index([noteId])
  @@index([extractState])
  @@map("assets")
}

// One extracted page/slide/segment of an asset. Written as extraction goes so
// a long file can stop and resume without re-reading the whole document, and
// digested one call per row so the map stage checkpoints. Cascade-deleted with
// the asset: source text never outlives the file it belongs to.
model SourceChunk {
  id                  String   @id @default(cuid())
  assetId             String
  asset               Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  index               Int
  // Outline section this chunk belongs to (structure stage); null until set.
  sectionId           String?
  // Human-readable place in the file, e.g. "p. 41-47", "Slide 4", "about 12:30".
  label               String?
  startPage           Int?
  endPage             Int?
  text                String   @db.Text
  hash                String
  digest              Json?
  digestPromptVersion String?
  digestModel         String?
  // pending | done | failed
  status              String   @default("pending")
  errorCode           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([assetId, index])
  @@index([assetId, status])
  @@index([hash])
  @@index([userId])
  @@map("source_chunks")
}

model Job {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId     String
  note       Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  kind       String    @default("study_set")
  // queued | running | failed | done
  state      String    @default("queued")
  // queued | transcribing | summarising | making_cards — mirrored to note.aiState
  stage      String    @default("queued")
  // JSON payload for kinds that carry extra inputs (quiz_marking answers).
  payload    String?   @db.Text
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  // Client progress: what stage fraction is done, e.g. "Reading pages 41 of 212".
  progressDone  Int     @default(0)
  progressTotal Int     @default(0)
  error       String?
  errorCode   String?
  errorStage  String?
  checkpoint  Json?
  runAfter    DateTime  @default(now())
  lockedUntil DateTime?
  // Hash of the cleaned source; identical requests reuse existing outputs.
  sourceHash  String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  aiCalls AiCall[]

  @@index([userId, updatedAt])
  @@index([noteId])
  @@index([state, runAfter])
  @@index([lockedUntil])
  @@map("jobs")
}

// Object keys whose bytes could not be deleted alongside their asset row.
// The tick janitor retries with backoff; a row is removed once the object is
// gone, so a transient storage error never leaves student files behind.
model StorageDeletion {
  id            String    @id @default(cuid())
  userId        String
  provider      String    @default("cloudinary")
  publicId      String
  resourceType  String    @default("raw")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([nextAttemptAt])
  @@map("storage_deletions")
}

model AiCall {
  id               String   @id @default(cuid())
  jobId            String
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  step             String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  usdMicros        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@map("ai_calls")
}

model Flashcard {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId       String
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  courseId     String
  front        String
  back         String
  dueAt        DateTime @default(now())
  ease         Float    @default(2.5)
  intervalDays Float    @default(0)
  reps         Int      @default(0)
  // Set when a regeneration no longer produces this card. Soft-retired cards
  // keep review history in review_logs intact but are excluded from study.
  retiredAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviewLogs  ReviewLog[]

  @@index([userId, updatedAt])
  @@index([noteId])
  @@map("flashcards")
}

model Quiz {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  noteId    String?
  // Cascade: quiz questions and attempts are the note's content and go with it.
  note      Note?          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  title     String
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, updatedAt])
  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id          String @id @default(cuid())
  quizId      String
  quiz        Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  ordinal     Int
  // mcq | true_false | short_answer
  type        String
  prompt      String
  options     Json?
  answer      String
  explanation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quizId])
  @@map("quiz_questions")
}

model ReviewLog {
  id               String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId           String
  card             Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  // again | hard | good | easy
  grade            String
  reviewedAt       DateTime
  prevIntervalDays Float
  newIntervalDays  Float
  createdAt        DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([cardId])
  @@map("review_logs")
}

model QuizAttempt {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  startedAt DateTime
  finishedAt DateTime
  total     Int
  correct   Int      @default(0)
  // local | pending_marking | marked | marking_failed
  state     String   @default("local")
  // details Per-question results: [{questionId, answer, correct, comment}]
  details   Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, finishedAt])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Feedback {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId     String?
  // summary | flashcard | quiz_question | transcript
  targetType String
  targetId   String?
  comment    String
  sourceText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("feedback")
}

model Usage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month            String
  summaries        Int      @default(0)
  studySets        Int      @default(0)
  // Course-reference sheets are their own AI product, so they count separately.
  references       Int      @default(0)
  assistantQueries Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, month])
  @@map("usages")
}

model ChatMessage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // user | assistant
  role          String
  content       String   @db.Text
  sourceNoteIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId, courseId, createdAt])
  @@map("chat_messages")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}
