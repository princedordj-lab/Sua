{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "src/index.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/**/pdfjs-dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/internal/jobs/tick?maxJobs=5&maxAssets=3",
      "schedule": "*/2 * * * *"
    }
  ]
}
