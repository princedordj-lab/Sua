PORT=4000
NODE_ENV=development
# Neon Postgres. Use the pooled endpoint for the app runtime and the direct
# (unpooled) endpoint for migrations. neonctl connection-string [--pooled]
DATABASE_URL="postgresql://user:password@host/pooled_db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# Clerk dashboard -> API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Clerk dashboard -> Webhooks -> endpoint signing secret (svix)
CLERK_WEBHOOK_SECRET=
# Neon Console -> Project API key and the target branch. Create a private
# Object Storage bucket named sua-assets (or set NEON_STORAGE_BUCKET).
NEON_API_KEY=
NEON_PROJECT_ID=fancy-frost-08821220
NEON_BRANCH_ID=br-ancient-sound-b4pgkvws
NEON_STORAGE_BUCKET=sua-assets
# Keep Cloudinary configured during the compatibility period and until the
# asset migration command has completed and the legacy app window has ended.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ORIGIN=*
# Cron secret for securing POST /api/internal/jobs/tick (used by Vercel Cron or external schedulers)
CRON_SECRET=
# Gemini (Google AI Studio key). Transcription + image OCR; text generation uses xkiro.
GEMINI_API_KEY=
# xkiro (OpenAI-compatible chat completions): notes, summaries, cards, quizzes.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Optional model overrides
TRANSCRIPTION_MODEL=gemini-3.8-flash
TRANSCRIPTION_FALLBACK_MODEL=gemini-3.5-flash
# One model serves both tiers unless you override them separately.
AI_MODEL=qwen/qwen3.8-max:free
AI_BULK_MODEL=qwen/qwen3.8-max:free
AI_STRONG_MODEL=qwen/qwen3.8-max:free
# Free-plan monthly caps (warn-only until Milestone 5 billing)
FREE_MONTHLY_SUMMARIES=10
FREE_MONTHLY_SETS=10
FREE_ASSISTANT_QUERIES=15
# Background document extraction (uploads). Text is read page by page after the
# upload response is sent; these knobs cap pages, time and OCR fan-out.
MAX_NOTE_PAGES=100
MAX_REFERENCE_PAGES=100
EXTRACT_BUDGET_MS=200000
EXTRACT_STALE_RUNNING_MS=600000
OCR_MIN_CHARS=40
OCR_CONCURRENCY=3
OCR_PAGE_TIMEOUT_MS=45000
# Cost tracking: USD->GHS conversion and a daily spend alert threshold
USD_TO_GHS_RATE=15
AI_DAILY_SPEND_ALERT_GHS=50
