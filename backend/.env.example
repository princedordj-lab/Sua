PORT=4000
NODE_ENV=development
# Neon Postgres. Use the pooled endpoint for the app runtime and the direct
# (unpooled) endpoint for migrations. neonctl connection-string [--pooled]
DATABASE_URL="postgresql://user:password@host/pooled_db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# Clerk dashboard -> API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Clerk dashboard -> Webhooks -> endpoint signing secret (svix)
CLERK_WEBHOOK_SECRET=
CORS_ORIGIN=*
