PORT=4000
NODE_ENV=development
# Neon Postgres. Use the pooled endpoint for the app runtime and the direct
# (unpooled) endpoint for migrations. neonctl connection-string [--pooled]
DATABASE_URL="postgresql://user:password@host/pooled_db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# Clerk dashboard -> API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Clerk dashboard -> Webhooks -> endpoint signing secret (svix)
CLERK_WEBHOOK_SECRET=
# Cloudinary dashboard -> Settings -> API Keys (uploads are signed server-side;
# secrets are never sent to the client)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ORIGIN=*
# Upstash Redis (BullMQ for the AI pipeline)
REDIS_URL="rediss://default:password@host:6379"
# Gemini (Google AI Studio key). Transcription + image OCR; bulk generation uses OpenRouter.
GEMINI_API_KEY=
# OpenRouter (summaries, flashcards, quizzes)
OPENROUTER_API_KEY=
# Optional model overrides
TRANSCRIPTION_MODEL=gemini-3.1-flash
TRANSCRIPTION_FALLBACK_MODEL=gemini-3.1-flash
AI_BULK_MODEL=google/gemini-3.5-flash
AI_STRONG_MODEL=google/gemini-3.5-flash
# Free-plan monthly caps (warn-only until Milestone 5 billing)
FREE_MONTHLY_SUMMARIES=10
FREE_MONTHLY_SETS=10
FREE_ASSISTANT_QUERIES=15
# Cost tracking: USD->GHS conversion and a daily spend alert threshold
USD_TO_GHS_RATE=15
AI_DAILY_SPEND_ALERT_GHS=50
