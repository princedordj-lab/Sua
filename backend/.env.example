PORT=4000
NODE_ENV=development
# Neon Postgres. Use the pooled endpoint for the app runtime and the direct
# (unpooled) endpoint for migrations. neonctl connection-string [--pooled]
DATABASE_URL="postgresql://user:password@host/pooled_db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# Connections this process opens against DATABASE_URL. Every withUser transaction
# pins one for its whole lifetime and each statement is a WAN round trip, so this
# is a concurrency cap, not a throughput knob (see src/config/prisma.js). Default 5.
# PG_POOL_MAX=5
# Clerk dashboard -> API Keys
#
# CLERK_PUBLISHABLE_KEY and CLERK_SECRET_KEY must come from the SAME instance as
# the client's publishable key (mobile: EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY, web:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY). The middleware verifies every bearer token
# against this instance's keys: a `sk_test_` here with a `pk_live_` app returns
# 401 on every authenticated request, and the app can never load a profile.
# CLERK_WEBHOOK_SECRET must be the svix secret of a webhook endpoint on that
# same instance, or every delivery fails signature verification.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Clerk dashboard -> Webhooks -> endpoint signing secret (svix)
CLERK_WEBHOOK_SECRET=
# Neon Console -> Project API key and the target branch. Create a private
# Object Storage bucket named sua-assets (or set NEON_STORAGE_BUCKET).
NEON_API_KEY=
NEON_PROJECT_ID=fancy-frost-08821220
NEON_BRANCH_ID=br-ancient-sound-b4pgkvws
NEON_STORAGE_BUCKET=sua-assets
# Keep Cloudinary configured during the compatibility period and until the
# asset migration command has completed and the legacy app window has ended.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ORIGIN=*
# Cron secret for securing POST /api/internal/jobs/tick (used by Vercel Cron or external schedulers)
CRON_SECRET=
# ---------------------------------------------------------------------------
# Invocation budget (src/lib/budget.js). A serverless function is terminated at
# its maximum duration, so every pass must plan for less than that. 300 s is the
# documented Hobby *and* Pro ceiling with Fluid compute (on by default for new
# projects); set 60000 if the dashboard still shows the 60 s limit, because a
# budget above the real ceiling is worse than a small one. The boot log prints
# "[budget] {...}" so a mismatch is visible in the function logs.
# PLATFORM_MAX_DURATION_MS=300000
# Headroom kept for the final checkpoint/status writes before the ceiling.
# PROCESSING_SAFETY_MS=12000
# Silence after which a `running` job is declared interrupted. Derived from the
# lease (max(5 min, 2x lease)) unless set; never below the lease itself.
# INTERRUPTED_RUNNING_MS=
# A stage will not start a model call with less window than this left.
# MIN_AI_CALL_WINDOW_MS=25000
# Web Push (VAPID). Generate once with `npx web-push generate-vapid-keys` in
# backend/. The public key must also be present in web/.env.local as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY, and keys must never be rotated after release
# (rotation invalidates every browser subscription).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ssyncd.space
# Daily due-card reminder sweep in the jobs tick (web only; mobile schedules
# its reminder locally). Set REMINDERS_EXACT_TIME=1 only when the cron runs
# hourly (Pro plan), so each student's chosen reminderTime is honoured.
REMINDERS_ENABLED=1
REMINDERS_EXACT_TIME=0
# Gemini (Google AI Studio key). Transcription + image OCR; text generation uses xkiro.
GEMINI_API_KEY=
# xkiro (OpenAI-compatible chat completions): notes, summaries, cards, quizzes.
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Native document reading: Gemini reads the uploaded PDF itself (text, scans,
# charts) in one pass instead of the server parsing/OCR'ing it page by page.
# Set NATIVE_DOC_READ=0 to fall back to the legacy extractor everywhere.
# Photos are read the same way; DOCX/PPTX keep their local text and have the
# pictures inside them read (DOC_READ_EMBEDDED_IMAGES=0 disables that).
NATIVE_DOC_READ=1
DOC_READ_MODEL=gemini-3.5-flash
DOC_READ_FALLBACK_MODEL=gemini-2.5-flash
DOC_READ_MAX_PAGES=60
DOC_READ_INLINE_MAX_BYTES=14680064
DOC_READ_MAX_BYTES=26214400
DOC_READ_TIMEOUT_MS=120000
DOC_READ_MAX_TOKENS=32000
DOC_READ_QUOTA_COOLDOWN_MS=600000
DOC_READ_EMBEDDED_IMAGES=1
DOC_READ_MAX_IMAGES=24
DOC_READ_IMAGE_BATCH=6
DOC_READ_MIN_IMAGE_BYTES=6000
DOC_READ_IMAGE_MAX_TOKENS=1200
# LlamaParse (LlamaCloud REST): primary extractor for DOCX/PPTX, scan fallback
# for PDFs. Text PDFs are read locally for free; the provider only sees a PDF
# when no page has a usable text layer. Without the key, or with
# LLAMAPARSE_ENABLED=0, Sua uses the local extractors instead.
# LLAMAPARSE_FORMATS=docx,pptx keeps every PDF on the free local extractor.
# The tier is never changed automatically; cost_effective is the default.
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_ENABLED=1
LLAMAPARSE_FORMATS=pdf,docx,pptx
LLAMAPARSE_TIER=cost_effective
LLAMAPARSE_VERSION=latest
LLAMAPARSE_OCR_LANGUAGES=en
LLAMAPARSE_TIMEOUT_MS=1200000
LLAMAPARSE_MAX_ATTEMPTS=4
LLAMAPARSE_UPLOAD_TIMEOUT_MS=120000
LLAMAPARSE_REQUEST_TIMEOUT_MS=30000
# A file whose whole cleaned text fits this skips map/reduce (one generation call).
SHORT_SOURCE_CHARS=60000
# A processing row that has written no heartbeat for this long is offered a
# retry instead of showing progress forever. Default 7200000 (2h).
# PROCESSING_STALE_RUN_MS=7200000
# Optional model overrides
TRANSCRIPTION_MODEL=gemini-3.8-flash
TRANSCRIPTION_FALLBACK_MODEL=gemini-3.5-flash
# One model serves both tiers unless you override them separately.
AI_MODEL=qwen/qwen3.8-max:free
AI_BULK_MODEL=qwen/qwen3.8-max:free
AI_STRONG_MODEL=qwen/qwen3.8-max:free
# Free-plan monthly caps (warn-only until Milestone 5 billing)
FREE_MONTHLY_SUMMARIES=10
FREE_MONTHLY_SETS=10
FREE_ASSISTANT_QUERIES=15
