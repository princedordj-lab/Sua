    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "svix": "^2.8.0"
  },
